{
  "name": "dreamland",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "check": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build:web": "tsc --noEmit && vite build --mode web --base ./ --outDir web && node scripts/web-files.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "jsonrepair": "3.13.2",
    "mathjs": "12.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
